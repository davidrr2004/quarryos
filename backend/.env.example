# Database connection (replace with your values)
# Format: postgresql://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:your_password@localhost/quarryos

# JWT Secret (generate a strong one!)
# You can generate one using: openssl rand -hex 32
SECRET_KEY=ChangeMeWithAReallyStrongPasswordForProduction

# Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
